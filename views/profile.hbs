<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Профиль пользователя</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="/js/profile.js"></script>
</head>
<body>
    <div class="container">
        <div class="header">
            <a href="/" class="header-logo-link">
                <div class="header-logo">🌐</div>
            </a>
            <nav class="nav-menu">
                <a href="/" class="nav-link">Главная</a>
                <div class="dropdown">
                    <button class="nav-link nav-link--active dropdown-toggle">Личный кабинет</button>
                    <div class="dropdown-menu">
                        <a href="/profile" class="dropdown-item active">Основная информация</a>
                        <a href="/tariffs" class="dropdown-item">Управление тарифами</a>
                        <a href="/billing" class="dropdown-item">Биллинг и оплата</a>
                    </div>
                </div>
            </nav>
            <div class="auth-section">
                <a href="/notifications" class="header-notification-link">
                    <div class="header-notification">🔔</div>
                </a>
                <a href="/logout" class="auth-link">Выйти</a>
            </div>
        </div>

        <div class="profile-section">
            <div class="profile-header">
                <h1 class="profile-title">Личный кабинет</h1>
            </div>
            
            <div class="profile-content">
                <div class="profile-info">
                    <h2 class="section-title">Личные данные</h2>
                    <div class="info-group">
                        <label>Номер договора:</label>
                        <p>{{contract.number}}</p>
                    </div>
                    <div class="info-group">
                        <label>ФИО:</label>
                        <p>{{user.full_name}}</p>
                    </div>
                    <div class="profile-actions">
                        <button class="edit-button" onclick="showEditModal()">Редактировать</button>
                    </div>
                </div>

                <div class="profile-tariff">
                    <h2 class="section-title">Текущий тариф</h2>
                    {{#if tariff.name}}
                    <div class="current-tariff">
                        <h3>{{tariff.name}}</h3>
                        <p class="tariff-speed">{{tariff.speed}} Мбит/с</p>
                        <p class="tariff-price">{{tariff.price}} ₽/мес</p>
                        <p class="tariff-status">{{contract.status}}</p>
                    </div>
                    {{else}}
                    <div class="current-tariff">
                        <p>Тариф не подключен</p>
                        <a href="/tariffs" class="edit-button">Выбрать тариф</a>
                    </div>
                    {{/if}}
                </div>

                <div class="profile-usage">
                    <h2 class="section-title">Статистика</h2>
                    <div class="usage-stats">
                        <div class="stat-item">
                            <span class="stat-label">Дата оплаты:</span>
                            <span class="stat-value">15 числа</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">Баланс:</span>
                            <span class="stat-value">{{contract.balance}} ₽</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="editProfileModal" class="modal">
        <div class="modal-content">
            <span class="modal-close" onclick="closeEditModal()">&times;</span>
            <h2>Редактирование профиля</h2>
            <form id="editProfileForm" class="edit-profile-form">
                <div class="form-group">
                    <label for="editFullName">ФИО:</label>
                    <input type="text" id="editFullName" name="full_name" value="{{user.full_name}}" readonly>
                </div>
                <div class="form-group">
                    <label for="editPassword">Новый пароль:</label>
                    <input type="password" id="editPassword" name="password" minlength="6">
                    <span class="form-hint">Оставьте пустым, если не хотите менять пароль</span>
                </div>
                <div class="form-group">
                    <label for="editPasswordConfirm">Подтверждение пароля:</label>
                    <input type="password" id="editPasswordConfirm" name="passwordConfirm">
                </div>
                <button type="submit" class="submit-button">Сохранить изменения</button>
            </form>
        </div>
    </div>
</body>
</html>

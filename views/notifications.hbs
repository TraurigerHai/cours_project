<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Уведомления</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <div class="header">
            <a href="/" class="header-logo-link">
                <div class="header-logo">🌐</div>
            </a>
            <nav class="nav-menu">
                <a href="/" class="nav-link">Главная</a>
                <div class="dropdown">
                    <button class="nav-link nav-link--active dropdown-toggle">Личный кабинет</button>
                    <div class="dropdown-menu">
                        <a href="/profile" class="dropdown-item">Основная информация</a>
                        <a href="/tariffs" class="dropdown-item">Управление тарифами</a>
                        <a href="/billing" class="dropdown-item">Биллинг и оплата</a>
                    </div>
                </div>
            </nav>
            <div class="auth-section">
                <a href="/notifications" class="header-notification-link">
                    <div class="header-notification">🔔</div>
                </a>
                <a href="/logout" class="auth-link">Выйти</a>
            </div>
        </div>

        <section class="news-section">
            <h2 class="news-title">Уведомления</h2>
            {{#if error}}
                <div class="error-message">{{error}}</div>
            {{/if}}
            <div class="news-container">
                {{#each notifications}}
                <article class="news-item {{#if importance}}news-item--important{{/if}}">
                    <div class="news-date">{{date}}</div>
                    <p class="news-content">{{content}}</p>
                </article>
                {{else}}
                <p class="no-notifications">Нет новых уведомлений</p>
                {{/each}}
            </div>
        </section>
    </div>
</body>
</html>

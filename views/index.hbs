<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Интернет провайдер - Главная</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <div class="header">
            <a href="/" class="header-logo-link">
                <div class="header-logo">🌐</div>
            </a>
            <nav class="nav-menu">
                <a href="/" class="nav-link nav-link--active">Главная</a>
                {{#if userId}}
                <div class="dropdown">
                    <button class="nav-link dropdown-toggle">Личный кабинет</button>
                    <div class="dropdown-menu">
                        <a href="/profile" class="dropdown-item">Основная информация</a>
                        <a href="/tariffs" class="dropdown-item">Управление тарифами</a>
                        <a href="/billing" class="dropdown-item">Биллинг и оплата</a>
                    </div>
                </div>
                {{/if}}
            </nav>
            <div class="auth-section">
                {{#if userId}}
                <a href="/notifications" class="header-notification-link">
                    <div class="header-notification">🔔</div>
                </a>
                <a href="/logout" class="auth-link">Выйти</a>
                {{else}}
                <a href="/login" class="auth-link">Войти</a>
                {{/if}}
            </div>
        </div>

        <section class="hero">
            <div class="hero__content">
                <h1 class="hero__title">Интернет для вашего дома</h1>
                <p class="hero__subtitle">Скорость до 1000 Мбит/с</p>
                <div class="hero__features">
                    <div class="hero__feature">✓ Бесплатное подключение</div>
                    <div class="hero__feature">✓ Поддержка 24/7</div>
                    <div class="hero__feature">✓ Wi-Fi роутер в подарок</div>
                </div>
                <a href="#tariffs" class="hero__button">Выбрать тариф</a>
            </div>
            <div class="hero__decoration"></div>
        </section>

        <section class="advantages">
            <h2 class="section-title">Почему выбирают нас</h2>
            <div class="advantages__grid">
                <div class="advantage-card">
                    <div class="advantage-card__icon">🚀</div>
                    <h3>Высокая скорость</h3>
                    <p>До 1000 Мбит/с для загрузки и онлайн игр</p>
                </div>
                <div class="advantage-card">
                    <div class="advantage-card__icon">💎</div>
                    <h3>Стабильность</h3>
                    <p>99.9% время работы сети</p>
                </div>
                <div class="advantage-card">
                    <div class="advantage-card__icon">🎮</div>
                    <h3>Низкий пинг</h3>
                    <p>Подходит для онлайн игр</p>
                </div>
                <div class="advantage-card">
                    <div class="advantage-card__icon">💰</div>
                    <h3>Выгодные цены</h3>
                    <p>Доступные тарифы для всех</p>
                </div>
            </div>
        </section>

        <section id="tariffs" class="tariffs">
            <h2 class="tariffs__title">Тарифные планы</h2>
            {{#if error}}
                <div class="error-message">{{error}}</div>
            {{/if}}
            <div class="tariffs__grid">
                {{#each tariffs}}
                <div class="tariff-card">
                    <h3 class="tariff-card__title">{{name}}</h3>
                    <div class="tariff-card__content">
                        <p class="tariff-card__speed">{{speed}} Мбит/с</p>
                        {{#if limit_gb}}
                            <p class="tariff-card__traffic">{{limit_gb}} ГБ</p>
                        {{else}}
                            <p class="tariff-card__traffic">Безлимитный</p>
                        {{/if}}
                        <p class="tariff-card__price">{{price}} ₽/мес</p>
                        {{#if ../userId}}
                            <div class="tariff-card__actions">
                                <button class="tariff-card__button" data-tariff-id="{{id}}">Подключить</button>
                                <p class="tariff-card__notice">Быстрое подключение через личный кабинет</p>
                            </div>
                        {{else}}
                            <div class="tariff-card__actions">
                                <button class="tariff-card__button tariff-card__button--guest" data-tariff-id="{{id}}">Оставить заявку</button>
                                <div class="tariff-card__login-hint">
                                    <span class="tariff-card__login-text">Уже являетесь нашим клиентом?</span>
                                    <a href="/login" class="tariff-card__login-link">Войти в личный кабинет</a>
                                </div>
                            </div>
                        {{/if}}
                    </div>
                </div>
                {{/each}}
            </div>
        </section>

        <!-- Модальное окно -->
        <div id="guestConnectionModal" class="modal">
            <div class="modal-content">
                <span class="modal-close">&times;</span>
                <h2>Оставить заявку на подключение</h2>
                <div class="tariff-info"></div>
                <form id="guestConnectionForm" class="connection-form">
                    <input type="hidden" name="tariffId" value="">
                    <div class="form-group">
                        <label for="guest_name">Ваше имя*</label>
                        <input type="text" id="guest_name" name="name" required>
                    </div>
                    <div class="form-group">
                        <label for="guest_phone">Телефон*</label>
                        <input type="tel" id="guest_phone" name="phone" pattern="[0-9]{11}" required>
                        <small class="form-hint">Формат: 79991234567</small>
                    </div>
                    <div class="form-group">
                        <label for="guest_address">Адрес подключения*</label>
                        <input type="text" id="guest_address" name="address" required>
                    </div>
                    <div class="form-group">
                        <label for="guest_email">Email</label>
                        <input type="email" id="guest_email" name="email">
                    </div>
                    <div class="form-group">
                        <label for="guest_comment">Комментарий</label>
                        <textarea id="guest_comment" name="comment"></textarea>
                    </div>
                    <div class="form-group form-checkbox">
                        <input type="checkbox" id="agreement" name="agreement" required>
                        <label for="agreement">Согласен на обработку персональных данных</label>
                    </div>
                    <button type="submit" class="submit-button">Отправить заявку</button>
                </form>
            </div>
        </div>

        <section class="news-section">
            <h2 class="news-title">Новости и обновления</h2>
            <div class="news-container">
                <article class="news-item">
                    <div class="news-date">15 Января 2024</div>
                    <h3 class="news-item-title">Увеличение скорости</h3>
                    <p class="news-content">Мы увеличили скорость интернета на всех тарифах без изменения стоимости!</p>
                </article>
                
                <article class="news-item news-item--important">
                    <div class="news-date">10 Января 2024</div>
                    <h3 class="news-item-title">Технические работы</h3>
                    <p class="news-content">Плановые технические работы 20 января с 02:00 до 05:00.</p>
                </article>
                
                <article class="news-item">
                    <div class="news-date">5 Января 2024</div>
                    <h3 class="news-item-title">Новый тариф</h3>
                    <p class="news-content">Запуск нового тарифа "Премиум+" со скоростью до 1 Гбит/с!</p>
                </article>
            </div>
        </section>
    </div>
    <script src="/js/index.js"></script>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <div class="header">
            <a href="/" class="logo-link">
                <div class="site-logo">🌐</div>
            </a>
            <nav class="nav-menu">
                <a href="" class="nav-link nav-link--active">first</a>
                <a href="" class="nav-link">second</a>
                <a href="" class="nav-link">third</a>
                <a href="" class="nav-link">fourth</a>
            </nav>
            <div class="auth-section">
                <a href="/login" class="auth-link">Войти</a>
            </div>
        </div>
        
        <section class="tariff-section">
            <h2 class="tariff-section-title">Тарифные планы</h2>
            <div class="tariff-grid">
                <div class="tariff-card">
                    <h3 class="tariff-title">Базовый</h3>
                    <div class="tariff-content">
                        <p class="tariff-speed">100 Мбит/с</p>
                        <p class="tariff-traffic">Безлимитный</p>
                        <p class="tariff-price">500 ₽/мес</p>
                    </div>
                    <button class="tariff-button">Подключить</button>
                </div>

                <div class="tariff-card">
                    <h3 class="tariff-title">Стандарт</h3>
                    <div class="tariff-content">
                        <p class="tariff-speed">300 Мбит/с</p>
                        <p class="tariff-traffic">Безлимитный</p>
                        <p class="tariff-price">800 ₽/мес</p>
                    </div>
                    <button class="tariff-button">Подключить</button>
                </div>

                <div class="tariff-card">
                    <h3 class="tariff-title">Премиум</h3>
                    <div class="tariff-content">
                        <p class="tariff-speed">500 Мбит/с</p>
                        <p class="tariff-traffic">Безлимитный</p>
                        <p class="tariff-price">1200 ₽/мес</p>
                    </div>
                    <button class="tariff-button">Подключить</button>
                </div>
            </div>
        </section>
    </div>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Профиль пользователя</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <div class="header">
            <a href="/" class="header-logo-link">
                <div class="header-logo">🌐</div>
            </a>
            <nav class="nav-menu">
                <a href="/" class="nav-link">Главная</a>
                <div class="dropdown">
                    <button class="nav-link nav-link--active dropdown-toggle">Личный кабинет</button>
                    <div class="dropdown-menu">
                        <a href="/profile" class="dropdown-item">Основная информация</a>
                        <a href="/tariffs" class="dropdown-item active">Управление тарифами</a>
                        <a href="/billing" class="dropdown-item">Биллинг и оплата</a>
                    </div>
                </div>
            </nav>
            <div class="auth-section">
                <a href="/notifications" class="header-notification-link">
                    <div class="header-notification">🔔</div>
                </a>
                <a href="/logout" class="auth-link">Выйти</a>
            </div>
        </div>

        <section class="tariffs">
            <h2 class="tariffs__title">Тарифные планы</h2>
            {{#if error}}
                <div class="error-message">{{error}}</div>
            {{/if}}
            <div class="tariffs__grid">
                {{#each tariffs}}
                <div class="tariff-card">
                    <h3 class="tariff-card__title">{{name}}</h3>
                    <div class="tariff-card__content">
                        <p class="tariff-card__speed">{{speed}} Мбит/с</p>
                        {{#if limit_gb}}
                            <p class="tariff-card__traffic">{{limit_gb}} ГБ</p>
                        {{else}}
                            <p class="tariff-card__traffic">Безлимитный</p>
                        {{/if}}
                        <p class="tariff-card__price">{{price}} ₽/мес</p>
                    </div>
                    <button class="tariff-card__button" data-tariff-id="{{id}}">Подключить</button>
                </div>
                {{/each}}
            </div>
        </section>

        <!-- Модальное окно подключения -->
        <div id="connectionModal" class="modal">
            <div class="modal-content">
                <span class="modal-close">&times;</span>
                <h2>Подключение тарифа</h2>
                <div class="tariff-info"></div>
                <form id="connectionForm" class="connection-form">
                    <input type="hidden" name="tariffId" value="">
                    <div class="form-group">
                        <label>ФИО:</label>
                        <p class="form-static-text">{{user.full_name}}</p>
                        <input type="hidden" name="name" value="{{user.full_name}}">
                    </div>
                    <div class="form-group">
                        <label>Телефон:</label>
                        <p class="form-static-text">{{user.phone}}</p>
                        <input type="hidden" name="phone" value="{{user.phone}}">
                    </div>
                    <div class="form-group">
                        <label for="address">Адрес подключения*</label>
                        <input type="text" id="address" name="address" required>
                    </div>
                    <div class="form-group">
                        <label for="comment">Комментарий</label>
                        <textarea id="comment" name="comment"></textarea>
                    </div>
                    <button type="submit" class="submit-button">Отправить заявку</button>
                </form>
            </div>
        </div>

        <script src="/js/tariffs.js"></script>
    </div>
</body>
</html>
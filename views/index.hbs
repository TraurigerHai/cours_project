<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <div class="header">
            <a href="/" class="header-logo-link">
                <div class="header-logo">🌐</div>
            </a>
            <nav class="nav-menu">
                <a href="" class="nav-link nav-link--active">first</a>
                <a href="" class="nav-link">second</a>
                <a href="" class="nav-link">third</a>
                <a href="" class="nav-link">fourth</a>
            </nav>
            <div class="auth-section">
                <a href="/login" class="auth-link">Войти</a>
            </div>
        </div>
        
        <section class="news-section">
            <h2 class="news-title">Новости и обновления</h2>
            <div class="news-container">
                <article class="news-item">
                    <div class="news-date">15 Января 2024</div>
                    <h3 class="news-item-title">Увеличение скорости</h3>
                    <p class="news-content">Мы увеличили скорость интернета на всех тарифах без изменения стоимости!</p>
                </article>
                
                <article class="news-item news-item--important">
                    <div class="news-date">10 Января 2024</div>
                    <h3 class="news-item-title">Технические работы</h3>
                    <p class="news-content">Плановые технические работы 20 января с 02:00 до 05:00.</p>
                </article>
                
                <article class="news-item">
                    <div class="news-date">5 Января 2024</div>
                    <h3 class="news-item-title">Новый тариф</h3>
                    <p class="news-content">Запуск нового тарифа "Премиум+" со скоростью до 1 Гбит/с!</p>
                </article>
            </div>
        </section>

        <section class="tariffs">
            <h2 class="tariffs__title">Тарифные планы</h2>
            <div class="tariffs__grid">
                <div class="tariff-card">
                    <h3 class="tariff-card__title">Базовый</h3>
                    <div class="tariff-card__content">
                        <p class="tariff-card__speed">100 Мбит/с</p>
                        <p class="tariff-card__traffic">Безлимитный</p>
                        <p class="tariff-card__price">500 ₽/мес</p>
                    </div>
                    <button class="tariff-card__button">Подключить</button>
                </div>

                <div class="tariff-card">
                    <h3 class="tariff-card__title">Стандарт</h3>
                    <div class="tariff-card__content">
                        <p class="tariff-card__speed">300 Мбит/с</p>
                        <p class="tariff-card__traffic">Безлимитный</p>
                        <p class="tariff-card__price">800 ₽/мес</p>
                    </div>
                    <button class="tariff-card__button">Подключить</button>
                </div>

                <div class="tariff-card">
                    <h3 class="tariff-card__title">Премиум</h3>
                    <div class="tariff-card__content">
                        <p class="tariff-card__speed">500 Мбит/с</p>
                        <p class="tariff-card__traffic">Безлимитный</p>
                        <p class="tariff-card__price">1200 ₽/мес</p>
                    </div>
                    <button class="tariff-card__button">Подключить</button>
                </div>
            </div>
        </section>
    </div>
</body>
</html>